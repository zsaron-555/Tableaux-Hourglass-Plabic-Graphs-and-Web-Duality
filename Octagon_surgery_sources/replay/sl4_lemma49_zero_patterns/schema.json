{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sl4_lemma49_zero_pair_v1",
  "title": "Embedded local SL4 zero-pair pattern",
  "type": "object",
  "required": ["schema", "id", "source", "matching", "conclusion", "W", "X"],
  "properties": {
    "schema": {"const": "sl4_lemma49_zero_pair_v1"},
    "id": {"type": "string"},
    "source": {"type": "object"},
    "matching": {"type": "object"},
    "conclusion": {
      "type": "object",
      "required": ["action", "pairing_value"],
      "properties": {
        "action": {"const": "discharge_pair"},
        "pairing_value": {"const": 0}
      }
    },
    "W": {"$ref": "#/$defs/localWeb"},
    "X": {"$ref": "#/$defs/localWeb"}
  },
  "$defs": {
    "localWeb": {
      "type": "object",
      "required": ["boundary_order", "ports", "nodes", "edges", "crossings"],
      "properties": {
        "boundary_order": {"type": "array", "items": {"type": "string"}},
        "ports": {"type": "array", "items": {"type": "string"}},
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "role", "color", "x", "y"]
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "u", "v", "kind", "multiplicity"],
            "properties": {
              "kind": {
                "enum": ["ordinary", "hourglass", "ordinary_or_hourglass"]
              },
              "multiplicity": {
                "oneOf": [
                  {"type": "integer", "enum": [1, 2]},
                  {
                    "type": "array",
                    "items": {"type": "integer", "enum": [1, 2]},
                    "minItems": 1,
                    "uniqueItems": true
                  }
                ]
              }
            }
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "edge_ids", "kind", "count"],
            "properties": {
              "type": {"const": "exact_edge_kind_count"},
              "edge_ids": {
                "type": "array",
                "items": {"type": "string"},
                "minItems": 1,
                "uniqueItems": true
              },
              "kind": {"enum": ["ordinary", "hourglass"]},
              "count": {"type": "integer", "minimum": 0}
            }
          }
        },
        "crossings": {"type": "array"}
      }
    }
  }
}
